# ---------------------------------------------------------------------------
# pokedex-ex configuration. Copy to `.env.local` and fill in what you have.
# Every key is OPTIONAL — with an empty file the app still runs, using the free
# pokemontcg.io API plus HTML scraping for PriceCharting and eBay sold prices.
# ---------------------------------------------------------------------------

# --- Card identification --------------------------------------------------
# pokemontcg.io works without a key at ~1000 requests/day. A free key raises
# that to 20000/day: https://dev.pokemontcg.io/
POKEMONTCG_API_KEY=

# --- PriceCharting --------------------------------------------------------
# Paid API token (~$10/mo): https://www.pricecharting.com/api-documentation
# If unset, the PriceCharting provider falls back to scraping the public
# product page. Set to a token to use the documented API instead.
PRICECHARTING_TOKEN=

# --- eBay -----------------------------------------------------------------
# Create an app at https://developer.ebay.com/my/keys — you want the
# *Production* client id + secret. These alone enable the Browse API
# (active listings).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Sold/completed listings come from the Marketplace Insights API, which is
# gated behind a separate application. Set this to "true" once eBay has
# granted your app access to buy.marketplace.insights.
EBAY_MARKETPLACE_INSIGHTS_ENABLED=false

# Which eBay marketplace to price against.
EBAY_MARKETPLACE_ID=EBAY_US

# --- Scraping fallback ----------------------------------------------------
# Master switch for the HTML-scraping providers. Turn off if you only want
# to use official APIs.
SCRAPE_ENABLED=true

# Minimum milliseconds between requests to the same host. Keep this polite.
SCRAPE_MIN_INTERVAL_MS=1500

# How long provider responses are cached on disk, in seconds.
CACHE_TTL_SECONDS=3600
